# SoccerstAI - Plantilla de Variables de Entorno
# Copia este archivo a .env y completa con tus claves reales.

# Groq Cloud API Key (Análisis IA de partidos)
EXPO_PUBLIC_GROQ_API_KEY=tu_groq_api_key_aqui

# Football-Data.org API Key (Resultados y calendarios)
EXPO_PUBLIC_FD_API_KEY=tu_football_data_api_key_aqui

# The Odds API Key (Cuotas de apuestas)
EXPO_PUBLIC_ODDS_API_KEY=tu_odds_api_key_aqui

# API-Football / API-Sports Key (API alternativa de fútbol)
EXPO_PUBLIC_FOOTBALL_API_KEY=tu_football_api_key_aqui
